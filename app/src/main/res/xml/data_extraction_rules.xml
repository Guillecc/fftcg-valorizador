<?xml version="1.0" encoding="utf-8"?>
<!-- Copia en la nube y traspaso entre teléfonos (API 31+): mismas reglas que backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="collection.json" />
        <include domain="file" path="backups" />
        <include domain="sharedpref" path="overrides.xml" />
        <include domain="sharedpref" path="fx.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="collection.json" />
        <include domain="file" path="backups" />
        <include domain="sharedpref" path="overrides.xml" />
        <include domain="sharedpref" path="fx.xml" />
    </device-transfer>
</data-extraction-rules>
